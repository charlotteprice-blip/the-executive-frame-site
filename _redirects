# Executive Frame — canonical URL redirects (Netlify / Cloudflare Pages)
# Canonical form is extensionless. 301 the .html form to it.
/index.html            /                       301!

# Retired / consolidated pages
/ef-health.html        /health                 301!
/ef-health             /health                 301!
/ef-health-products.html  /health-dgbi#products  301!
/ef-health-products       /health-dgbi#products  301!
/health-elearning.html /health-dgbi#self-paced-programme 301!
/health-elearning      /health-dgbi#self-paced-programme 301!
/health-gut-brain.html /health-dgbi            301!
/health-gut-brain      /health-dgbi            301!
/library.html          /resources              301!
/library               /resources              301!
/store.html            /resources              301!
/store                 /resources              301!

# Assessment: only if no assessment file exists on the host (not forced)
/assessment.html       /executive-frame-assessment 301
/assessment            /executive-frame-assessment 301

# General fallback: any remaining *.html -> extensionless
/*.html                /:splat                 301!
