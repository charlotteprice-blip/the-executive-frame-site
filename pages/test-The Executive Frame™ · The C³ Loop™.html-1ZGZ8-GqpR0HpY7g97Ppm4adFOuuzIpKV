<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Executive Frame™ · The C³ Loop™</title>
<style>
  :root{
    /* System B tokens — Executive Navy / Terracotta. Swap here if System A is selected. */
    --navy:#0F2438;
    --navy-soft:#1E3A54;
    --terracotta:#C4643B;
    --terracotta-soft:#E8C9B8;
    --paper:#FAFAF8;
    --mist:#E9EDF0;
    --ink-60:rgba(15,36,56,.62);
    --ink-30:rgba(15,36,56,.30);
    --ink-12:rgba(15,36,56,.12);
    --radius:20px;
    --ease:cubic-bezier(.22,.61,.36,1);
    --sans:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Segoe UI",Inter,Helvetica,Arial,sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:var(--sans);
    background:var(--paper);
    color:var(--navy);
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }
  button{font-family:inherit;cursor:pointer;border:none;background:none}
  button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--terracotta);outline-offset:3px;border-radius:6px}
  input,textarea{font-family:inherit;color:var(--navy)}

  /* ---------- Header ---------- */
  header{
    position:sticky;top:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:18px clamp(20px,5vw,56px);
    background:rgba(250,250,248,.82);
    backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
    border-bottom:1px solid var(--ink-12);
  }
  .wordmark{font-size:14px;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
  .wordmark span{color:var(--terracotta)}

  /* Loop progress — the signature */
  .loop-nav{display:flex;align-items:center;gap:14px}
  .loop-nav svg{display:block}
  .loop-arc{fill:none;stroke:var(--ink-12);stroke-width:3.5;stroke-linecap:round;transition:stroke .5s var(--ease)}
  .loop-arc.done{stroke:var(--terracotta)}
  .loop-arc.current{stroke:var(--navy);animation:arcPulse 2.4s ease-in-out infinite}
  @keyframes arcPulse{0%,100%{opacity:1}50%{opacity:.45}}
  .loop-label{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-60);font-weight:600;min-width:120px;text-align:right}

  /* ---------- Stage shell ---------- */
  main{flex:1;display:flex;flex-direction:column}
  .stage{
    display:none;
    flex:1;
    max-width:720px;
    width:100%;
    margin:0 auto;
    padding:clamp(40px,7vh,80px) clamp(20px,5vw,40px) 100px;
    animation:stageIn .65s var(--ease) both;
  }
  .stage.active{display:block}
  @keyframes stageIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  }

  .eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--terracotta);font-weight:700;margin-bottom:14px}
  h1{font-size:clamp(34px,6vw,52px);font-weight:700;letter-spacing:-.025em;line-height:1.05;margin-bottom:18px}
  h1 .tm{font-size:.4em;vertical-align:super;font-weight:500}
  .lede{font-size:clamp(17px,2.4vw,20px);line-height:1.55;color:var(--ink-60);max-width:56ch;margin-bottom:44px}
  .lede strong{color:var(--navy);font-weight:600}

  .block{margin-bottom:52px}
  .block-label{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-30);font-weight:700;margin-bottom:18px}

  /* ---------- Metaphor canvases ---------- */
  .metaphor{
    border-radius:var(--radius);
    background:var(--navy);
    overflow:hidden;
    position:relative;
    aspect-ratio:16/8;
    display:flex;align-items:center;justify-content:center;
  }
  .metaphor svg{width:100%;height:100%;display:block}
  .metaphor-caption{font-size:14px;color:var(--ink-60);margin-top:14px;line-height:1.5;max-width:52ch}

  /* Centre: breathing horizon */
  @keyframes breatheCircle{0%,100%{r:34}45%,60%{r:58}}
  @keyframes breatheGlow{0%,100%{opacity:.25}45%,60%{opacity:.55}}
  /* Clarify: tunnel light */
  @keyframes tunnelIn{from{transform:scale(1.06);opacity:.9}to{transform:scale(1);opacity:1}}
  @keyframes lightBreathe{0%,100%{opacity:.75}50%{opacity:1}}
  /* Choose: door light */
  @keyframes doorGlow{0%,100%{opacity:.5}50%{opacity:.95}}
  /* Repeat: loop draw */
  @keyframes loopDraw{to{stroke-dashoffset:0}}

  /* ---------- Reflection ---------- */
  .card{
    background:#fff;
    border:1px solid var(--ink-12);
    border-radius:var(--radius);
    padding:clamp(22px,4vw,34px);
  }
  .prompt{font-size:19px;font-weight:600;letter-spacing:-.01em;line-height:1.4;margin-bottom:20px}
  .chip-row{display:flex;flex-wrap:wrap;gap:10px}
  .chip{
    padding:12px 22px;border-radius:999px;
    border:1.5px solid var(--ink-12);
    font-size:15px;font-weight:500;color:var(--navy);
    background:#fff;
    transition:all .25s var(--ease);
  }
  .chip:hover{border-color:var(--navy)}
  .chip.selected{background:var(--navy);border-color:var(--navy);color:#fff}
  .chip-note{font-size:14px;color:var(--ink-60);line-height:1.55;margin-top:18px;min-height:22px;transition:opacity .3s}
  textarea,.text-input{
    width:100%;border:1.5px solid var(--ink-12);border-radius:14px;
    padding:14px 16px;font-size:16px;line-height:1.5;background:#fff;
    resize:vertical;transition:border-color .2s;
  }
  textarea:focus,.text-input:focus{border-color:var(--navy);outline:none}
  .field-label{font-size:13px;font-weight:600;color:var(--ink-60);margin:18px 0 8px;display:block}
  .field-label:first-of-type{margin-top:0}

  /* ---------- Micro-tools ---------- */
  /* Breath tool */
  .breath-tool{display:flex;flex-direction:column;align-items:center;padding:34px 20px;text-align:center}
  .breath-visual{width:190px;height:190px;position:relative;display:flex;align-items:center;justify-content:center;margin-bottom:22px}
  .breath-ring{position:absolute;inset:0;border-radius:50%;border:1.5px solid var(--ink-12)}
  .breath-ball{
    width:70px;height:70px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #E28B60, var(--terracotta));
    transition:transform .3s;
  }
  .breath-ball.running{animation:ballBreath 10s ease-in-out infinite}
  @keyframes ballBreath{0%{transform:scale(1)}40%{transform:scale(2.1)}55%{transform:scale(2.1)}100%{transform:scale(1)}}
  .breath-phase{font-size:15px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-60);min-height:22px}
  .breath-count{font-size:13px;color:var(--ink-30);margin-top:6px;min-height:18px}

  /* Dump list */
  .dump-item{display:flex;gap:10px;margin-bottom:10px}
  .dump-item input{flex:1}
  .dump-pick{margin-top:20px;display:flex;flex-wrap:wrap;gap:10px}
  .pick-chip{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pick-chip.selected{background:var(--terracotta);border-color:var(--terracotta)}
  .dump-hint{font-size:14px;color:var(--ink-60);margin-top:14px;line-height:1.5}

  /* Commitment card */
  .commit-preview{
    margin-top:22px;border-radius:14px;
    background:var(--navy);color:#fff;
    padding:22px 24px;font-size:17px;line-height:1.55;
    min-height:64px;letter-spacing:-.005em;
  }
  .commit-preview em{color:var(--terracotta-soft);font-style:normal;font-weight:600}
  .commit-empty{color:rgba(255,255,255,.45);font-size:15px}

  /* ---------- Buttons ---------- */
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:14px 28px;border-radius:999px;
    font-size:16px;font-weight:600;letter-spacing:-.01em;
    transition:all .25s var(--ease);
  }
  .btn-primary{background:var(--navy);color:#fff}
  .btn-primary:hover{background:var(--navy-soft);transform:translateY(-1px)}
  .btn-accent{background:var(--terracotta);color:#fff}
  .btn-accent:hover{filter:brightness(1.07);transform:translateY(-1px)}
  .btn-ghost{border:1.5px solid var(--ink-12);color:var(--navy);background:#fff}
  .btn-ghost:hover{border-color:var(--navy)}
  .btn-sm{padding:10px 20px;font-size:14px}
  .btn[disabled]{opacity:.4;cursor:default;transform:none}

  .next-step{
    display:flex;flex-direction:column;gap:16px;
    border-top:1px solid var(--ink-12);padding-top:34px;
  }
  .next-step p{font-size:16px;color:var(--ink-60);line-height:1.55;max-width:54ch}
  .next-step p strong{color:var(--navy)}
  .step-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}

  /* ---------- Welcome & summary ---------- */
  .hero{
    text-align:center;
    display:flex;flex-direction:column;align-items:center;
    padding-top:clamp(30px,6vh,60px);
  }
  .hero .lede{margin-left:auto;margin-right:auto}
  .hero-loop{margin:10px 0 40px}
  .hero-loop svg{display:block}
  .hero-loop text{font-family:var(--sans)}

  .summary-block{margin-bottom:26px}
  .summary-block h3{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--terracotta);font-weight:700;margin-bottom:8px}
  .summary-block p{font-size:16px;line-height:1.6;white-space:pre-wrap}
  .summary-empty{color:var(--ink-30);font-style:italic}

  footer{
    padding:30px clamp(20px,5vw,56px) 44px;
    font-size:12.5px;line-height:1.6;color:var(--ink-30);
    border-top:1px solid var(--ink-12);
    max-width:900px;margin:0 auto;width:100%;
  }
  footer strong{color:var(--ink-60)}

  .toast{
    position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--navy);color:#fff;padding:12px 24px;border-radius:999px;
    font-size:14px;font-weight:500;opacity:0;pointer-events:none;
    transition:all .35s var(--ease);z-index:100;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  @media(max-width:560px){
    .loop-label{display:none}
    .metaphor{aspect-ratio:16/11}
  }
</style>
</head>
<body>

<header>
  <div class="wordmark">The Executive Frame<span>™</span></div>
  <nav class="loop-nav" aria-label="Journey progress">
    <span class="loop-label" id="loopLabel">Begin</span>
    <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
      <!-- four quadrant arcs, gap at joins -->
      <path class="loop-arc" id="arc0" d="M 20 4 A 16 16 0 0 1 36 20"/>
      <path class="loop-arc" id="arc1" d="M 36 20 A 16 16 0 0 1 20 36"/>
      <path class="loop-arc" id="arc2" d="M 20 36 A 16 16 0 0 1 4 20"/>
      <path class="loop-arc" id="arc3" d="M 4 20 A 16 16 0 0 1 20 4"/>
    </svg>
  </nav>
</header>

<main>

<!-- ═══════════ WELCOME ═══════════ -->
<section class="stage active hero" id="stage-welcome">
  <p class="eyebrow">The C³ Loop™</p>
  <h1>Centre. Clarify. Choose.<br>Then go again.</h1>
  <p class="lede">Four short movements. A few honest minutes. The C³ Loop™ is how The Executive Frame™ turns pressure into a working rhythm — <strong>settle the system, see what's actually there, act on what matters</strong> — and then repeats, because performance is a loop, not a ladder.</p>
  <div class="hero-loop" aria-hidden="true">
    <svg width="230" height="230" viewBox="0 0 230 230">
      <circle cx="115" cy="115" r="88" fill="none" stroke="var(--ink-12)" stroke-width="2"/>
      <path d="M 115 27 A 88 88 0 0 1 203 115" fill="none" stroke="var(--terracotta)" stroke-width="4" stroke-linecap="round"
            stroke-dasharray="140" stroke-dashoffset="140" style="animation:loopDraw 1.4s .3s var(--ease) forwards"/>
      <text x="115" y="14" text-anchor="middle" font-size="12" font-weight="600" fill="var(--navy)" letter-spacing="2">CENTRE</text>
      <text x="222" y="119" text-anchor="start" font-size="12" font-weight="600" fill="var(--navy)" letter-spacing="2" transform="rotate(0)">CLARIFY</text>
      <text x="115" y="226" text-anchor="middle" font-size="12" font-weight="600" fill="var(--navy)" letter-spacing="2">CHOOSE</text>
      <text x="8" y="119" text-anchor="end" font-size="12" font-weight="600" fill="var(--navy)" letter-spacing="2">REPEAT</text>
    </svg>
  </div>
  <button class="btn btn-accent" onclick="go(1)">Begin the loop</button>
</section>

<!-- ═══════════ 1 · CENTRE ═══════════ -->
<section class="stage" id="stage-1">
  <p class="eyebrow">01 · Centre</p>
  <h1>Regulation comes first.</h1>
  <p class="lede">Under load, the body decides what the mind is allowed to do. Before you plan, prioritise, or decide anything, <strong>bring your physiology back into range</strong>. A regulated nervous system is the platform every other executive skill stands on.</p>

  <div class="block">
    <p class="block-label">The metaphor</p>
    <div class="metaphor" role="img" aria-label="A slow breathing circle rising over a still horizon line">
      <svg viewBox="0 0 640 320" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0F2438"/><stop offset="1" stop-color="#1E3A54"/>
          </linearGradient>
        </defs>
        <rect width="640" height="320" fill="url(#sky)"/>
        <circle cx="320" cy="150" r="90" fill="#C4643B" opacity=".25" style="animation:breatheGlow 10s ease-in-out infinite"/>
        <circle cx="320" cy="150" r="34" fill="#E8C9B8" style="animation:breatheCircle 10s ease-in-out infinite"/>
        <line x1="0" y1="235" x2="640" y2="235" stroke="#FAFAF8" stroke-width="1.5" opacity=".8"/>
        <line x1="0" y1="235" x2="640" y2="235" stroke="#C4643B" stroke-width="4" opacity=".18"/>
      </svg>
    </div>
    <p class="metaphor-caption">A horizon doesn't move when the weather does. Centring is finding the line that stays level while everything above it changes.</p>
  </div>

  <div class="block">
    <p class="block-label">Reflection</p>
    <div class="card">
      <p class="prompt">Right now, how loaded is your system?</p>
      <div class="chip-row" id="centreBands" role="group" aria-label="Current state">
        <button class="chip" data-band="Settled" onclick="pickBand(this)">Settled</button>
        <button class="chip" data-band="Variable" onclick="pickBand(this)">Variable</button>
        <button class="chip" data-band="Loaded" onclick="pickBand(this)">Loaded</button>
      </div>
      <p class="chip-note" id="bandNote"></p>
    </div>
  </div>

  <div class="block">
    <p class="block-label">Micro-tool · One regulated minute</p>
    <div class="card breath-tool">
      <div class="breath-visual">
        <div class="breath-ring"></div>
        <div class="breath-ball" id="breathBall"></div>
      </div>
      <p class="breath-phase" id="breathPhase">Breathe in 4 · out 6</p>
      <p class="breath-count" id="breathCount">Six slow cycles. About a minute.</p>
      <br>
      <button class="btn btn-ghost btn-sm" id="breathBtn" onclick="toggleBreath()">Start</button>
    </div>
  </div>

  <div class="next-step">
    <p><strong>Next best step:</strong> drop your shoulders once more, unclench your jaw, and carry that longer exhale with you into the next movement.</p>
    <div class="step-actions">
      <button class="btn btn-primary" onclick="go(2)">Continue to Clarify →</button>
      <button class="btn btn-ghost btn-sm" onclick="exportSession()">Save my loop so far</button>
    </div>
  </div>
</section>

<!-- ═══════════ 2 · CLARIFY ═══════════ -->
<section class="stage" id="stage-2">
  <p class="eyebrow">02 · Clarify</p>
  <h1>See what's actually there.</h1>
  <p class="lede">A settled system can finally tell the difference between <strong>signal and noise</strong>. Clarifying is executive attention at work: naming what's occupying your mind, then sorting what is real and present from what is imagined or borrowed from tomorrow.</p>

  <div class="block">
    <p class="block-label">The metaphor · The Tunnel™</p>
    <div class="metaphor" role="img" aria-label="Concentric tunnel rings narrowing toward a single point of warm light">
      <svg viewBox="0 0 640 320" preserveAspectRatio="xMidYMid slice" style="animation:tunnelIn 1.2s var(--ease) both">
        <rect width="640" height="320" fill="#0F2438"/>
        <g fill="none" stroke="#FAFAF8" stroke-width="1.2">
          <ellipse cx="320" cy="160" rx="300" ry="150" opacity=".08"/>
          <ellipse cx="320" cy="160" rx="240" ry="120" opacity=".12"/>
          <ellipse cx="320" cy="160" rx="185" ry="92" opacity=".16"/>
          <ellipse cx="320" cy="160" rx="135" ry="67" opacity=".22"/>
          <ellipse cx="320" cy="160" rx="92" ry="46" opacity=".3"/>
          <ellipse cx="320" cy="160" rx="56" ry="28" opacity=".4"/>
        </g>
        <ellipse cx="320" cy="160" rx="26" ry="13" fill="#C4643B" style="animation:lightBreathe 4s ease-in-out infinite"/>
        <ellipse cx="320" cy="160" rx="46" ry="23" fill="#C4643B" opacity=".22" style="animation:lightBreathe 4s ease-in-out infinite"/>
      </svg>
    </div>
    <p class="metaphor-caption">The Tunnel™ isn't about seeing less — it's about the noise falling away until the one true thing is unmistakable.</p>
  </div>

  <div class="block">
    <p class="block-label">Reflection</p>
    <div class="card">
      <p class="prompt">What's taking up the most space in your mind right now — and what kind of thing is it?</p>
      <label class="field-label" for="clarifyText">Name it in one line</label>
      <input class="text-input" id="clarifyText" maxlength="140" placeholder="e.g. The report due Friday keeps circling…" oninput="state.clarifyItem=this.value">
      <label class="field-label">It's mostly a…</label>
      <div class="chip-row" role="group" aria-label="Type of thought">
        <button class="chip" data-kind="Fact — it's real and present" onclick="pickKind(this)">Fact</button>
        <button class="chip" data-kind="Feeling — it's a state, not a task" onclick="pickKind(this)">Feeling</button>
        <button class="chip" data-kind="Forecast — it hasn't happened yet" onclick="pickKind(this)">Forecast</button>
      </div>
      <p class="chip-note" id="kindNote"></p>
    </div>
  </div>

  <div class="block">
    <p class="block-label">Micro-tool · Three lines, one signal</p>
    <div class="card">
      <p class="prompt">Empty the top of your mind into three lines. Then choose the one that's actually yours to move today.</p>
      <div class="dump-item"><input class="text-input" id="dump0" maxlength="90" placeholder="Line one…" oninput="refreshPicks()"></div>
      <div class="dump-item"><input class="text-input" id="dump1" maxlength="90" placeholder="Line two…" oninput="refreshPicks()"></div>
      <div class="dump-item"><input class="text-input" id="dump2" maxlength="90" placeholder="Line three…" oninput="refreshPicks()"></div>
      <div class="dump-pick chip-row" id="dumpPicks" aria-label="Choose the one thing"></div>
      <p class="dump-hint" id="dumpHint">Your picks will appear here once you've written a line or two.</p>
    </div>
  </div>

  <div class="next-step">
    <p><strong>Next best step:</strong> let the other two lines wait — they've been named, so your mind can stop holding them. Take your one signal into Choose.</p>
    <div class="step-actions">
      <button class="btn btn-primary" onclick="go(3)">Continue to Choose →</button>
      <button class="btn btn-ghost btn-sm" onclick="go(1)">← Back to Centre</button>
      <button class="btn btn-ghost btn-sm" onclick="exportSession()">Save my loop so far</button>
    </div>
  </div>
</section>

<!-- ═══════════ 3 · CHOOSE ═══════════ -->
<section class="stage" id="stage-3">
  <p class="eyebrow">03 · Choose</p>
  <h1>One deliberate move.</h1>
  <p class="lede">Autonomy is the difference between reacting and choosing. This is where clarity becomes commitment: <strong>one values-aligned action</strong>, small enough to be certain, specific enough to be done. Not everything. One thing, chosen on purpose.</p>

  <div class="block">
    <p class="block-label">The metaphor</p>
    <div class="metaphor" role="img" aria-label="Three doorways, one lit from within">
      <svg viewBox="0 0 640 320" preserveAspectRatio="xMidYMid slice">
        <rect width="640" height="320" fill="#0F2438"/>
        <g stroke="#FAFAF8" stroke-width="1.5" fill="none" opacity=".35">
          <path d="M 130 260 V 130 A 45 45 0 0 1 220 130 V 260"/>
          <path d="M 420 260 V 130 A 45 45 0 0 1 510 130 V 260"/>
        </g>
        <path d="M 275 260 V 118 A 45 45 0 0 1 365 118 V 260" fill="#C4643B" opacity=".7" style="animation:doorGlow 5s ease-in-out infinite"/>
        <path d="M 275 260 V 118 A 45 45 0 0 1 365 118 V 260" fill="none" stroke="#E8C9B8" stroke-width="2"/>
        <line x1="60" y1="260" x2="580" y2="260" stroke="#FAFAF8" stroke-width="1.5" opacity=".5"/>
      </svg>
    </div>
    <p class="metaphor-caption">Every doorway is a real option. Choosing isn't closing the others — it's deciding which one you'll walk through first.</p>
  </div>

  <div class="block">
    <p class="block-label">Reflection</p>
    <div class="card">
      <p class="prompt">If the next hour went exactly the way you'd want, what would you have done — and why does it matter to you?</p>
      <label class="field-label" for="chooseWhy">It matters because…</label>
      <input class="text-input" id="chooseWhy" maxlength="140" placeholder="e.g. It protects my evening with the family…" oninput="state.chooseWhy=this.value">
    </div>
  </div>

  <div class="block">
    <p class="block-label">Micro-tool · The if–then commitment</p>
    <div class="card">
      <p class="prompt">Build your commitment. Specific beats ambitious.</p>
      <label class="field-label" for="commitWhen">When / if…</label>
      <input class="text-input" id="commitWhen" maxlength="110" placeholder="e.g. When I close this session…" oninput="buildCommit()">
      <label class="field-label" for="commitWhat">…I will</label>
      <input class="text-input" id="commitWhat" maxlength="110" placeholder="e.g. draft the opening paragraph — nothing more" oninput="buildCommit()">
      <div class="commit-preview" id="commitPreview" aria-live="polite">
        <span class="commit-empty">Your commitment will take shape here.</span>
      </div>
    </div>
  </div>

  <div class="next-step">
    <p><strong>Next best step:</strong> say the commitment once, out loud if you can. Spoken intentions recruit more of the brain than silent ones.</p>
    <div class="step-actions">
      <button class="btn btn-primary" onclick="go(4)">Close the loop →</button>
      <button class="btn btn-ghost btn-sm" onclick="go(2)">← Back to Clarify</button>
      <button class="btn btn-ghost btn-sm" onclick="exportSession()">Save my loop so far</button>
    </div>
  </div>
</section>

<!-- ═══════════ 4 · REPEAT ═══════════ -->
<section class="stage" id="stage-4">
  <p class="eyebrow">04 · Repeat</p>
  <h1>The loop is the practice.</h1>
  <p class="lede">Nothing here was a one-off fix. Regulation drifts, clarity fades, choices multiply — <strong>that's not failure, that's the operating condition</strong>. The skill is returning to the loop sooner each time, until Centre · Clarify · Choose becomes the way you meet pressure by default.</p>

  <div class="block">
    <p class="block-label">The metaphor</p>
    <div class="metaphor" role="img" aria-label="A circle drawing itself closed">
      <svg viewBox="0 0 640 320" preserveAspectRatio="xMidYMid slice">
        <rect width="640" height="320" fill="#0F2438"/>
        <circle cx="320" cy="160" r="105" fill="none" stroke="#FAFAF8" stroke-width="1.2" opacity=".18"/>
        <circle cx="320" cy="160" r="105" fill="none" stroke="#C4643B" stroke-width="4" stroke-linecap="round"
          stroke-dasharray="660" stroke-dashoffset="660" transform="rotate(-90 320 160)"
          style="animation:loopDraw 2s .4s var(--ease) forwards"/>
        <circle cx="320" cy="55" r="7" fill="#E8C9B8"/>
      </svg>
    </div>
    <p class="metaphor-caption">A loop that closes is a loop that can open again — stronger, and a little faster than the last time round.</p>
  </div>

  <div class="block">
    <p class="block-label">Reflection</p>
    <div class="card">
      <p class="prompt">Compared with when you started, what — if anything — has shifted?</p>
      <textarea id="shiftText" rows="3" maxlength="280" placeholder="Even a small shift counts. 'Slightly less noise' is a real answer." oninput="state.shift=this.value"></textarea>
    </div>
  </div>

  <div class="block">
    <p class="block-label">Micro-tool · Schedule your return</p>
    <div class="card">
      <p class="prompt">When will you run the loop next?</p>
      <div class="chip-row" role="group" aria-label="Next loop timing">
        <button class="chip" data-when="Before my next meeting" onclick="pickReturn(this)">Before my next meeting</button>
        <button class="chip" data-when="End of today" onclick="pickReturn(this)">End of today</button>
        <button class="chip" data-when="Tomorrow morning" onclick="pickReturn(this)">Tomorrow morning</button>
        <button class="chip" data-when="When I notice the load rising" onclick="pickReturn(this)">When I notice the load rising</button>
      </div>
      <p class="chip-note" id="returnNote"></p>
    </div>
  </div>

  <div class="block">
    <p class="block-label">Your loop, on one page</p>
    <div class="card" id="summaryCard"></div>
  </div>

  <div class="next-step">
    <p><strong>Next best step:</strong> take your summary with you — then close this tab. The loop lives in your day, not on the screen.</p>
    <div class="step-actions">
      <button class="btn btn-accent" onclick="exportSession()">Download my loop</button>
      <button class="btn btn-ghost" onclick="copySession()">Copy to clipboard</button>
      <button class="btn btn-ghost btn-sm" onclick="restart()">Run the loop again ↺</button>
    </div>
  </div>
</section>

</main>

<footer>
  <strong>A reflective practice, not an assessment.</strong> The C³ Loop™ is a self-guided reflection tool from The Executive Frame™. It doesn't measure, score, or diagnose anything, and it isn't a substitute for clinical care. If you're carrying more than a tool like this can hold, please reach out to a health professional or your local support services.
  <br><br>© The Executive Frame™ · C³ Loop™ · The Tunnel™ — Sarah Anticich Consulting. All frameworks and marks are proprietary.
</footer>

<div class="toast" id="toast">Copied</div>

<script>
const state = {
  band:null, clarifyItem:'', clarifyKind:null,
  dumps:['','',''], signal:null,
  chooseWhy:'', commitWhen:'', commitWhat:'',
  shift:'', returnWhen:null, breathDone:false
};

const stages = ['stage-welcome','stage-1','stage-2','stage-3','stage-4'];
const labels = ['Begin','Centre','Clarify','Choose','Repeat'];
let current = 0;

function go(i){
  document.getElementById(stages[current]).classList.remove('active');
  current = i;
  const el = document.getElementById(stages[current]);
  el.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  document.getElementById('loopLabel').textContent = labels[i];
  for(let a=0;a<4;a++){
    const arc = document.getElementById('arc'+a);
    arc.classList.toggle('done', i-1 > a);
    arc.classList.toggle('current', i-1 === a);
  }
  if(i===4) renderSummary();
  stopBreath();
}

/* ---- Centre ---- */
const bandNotes = {
  'Settled':'Good platform. Use this state well — settled systems make the clearest calls.',
  'Variable':'Honest answer. Variable is workable — one regulated minute below will steady the baseline.',
  'Loaded':'Noticing load is already regulation beginning. Give the breath tool a full minute before moving on.'
};
function pickBand(btn){
  document.querySelectorAll('#centreBands .chip').forEach(c=>c.classList.remove('selected'));
  btn.classList.add('selected');
  state.band = btn.dataset.band;
  document.getElementById('bandNote').textContent = bandNotes[state.band];
}

let breathTimer=null, cycleCount=0;
function toggleBreath(){
  if(breathTimer){ stopBreath(); return; }
  const ball=document.getElementById('breathBall');
  const phase=document.getElementById('breathPhase');
  const count=document.getElementById('breathCount');
  document.getElementById('breathBtn').textContent='Stop';
  ball.classList.add('running');
  cycleCount=0;
  const cycle=()=>{
    cycleCount++;
    if(cycleCount>6){ stopBreath(); phase.textContent='Well held.'; count.textContent='Your minute is complete.'; state.breathDone=true; return; }
    count.textContent='Cycle '+cycleCount+' of 6';
    phase.textContent='Breathe in… (4)';
    breathTimer=setTimeout(()=>{ phase.textContent='…and long out (6)';
      breathTimer=setTimeout(cycle,6000); },4000);
  };
  cycle();
}
function stopBreath(){
  if(breathTimer){clearTimeout(breathTimer);breathTimer=null;}
  const ball=document.getElementById('breathBall');
  if(ball){ ball.classList.remove('running');
    document.getElementById('breathBtn').textContent='Start'; }
}

/* ---- Clarify ---- */
const kindNotes = {
  "Fact — it's real and present":"Facts respond to action. This one can move to Choose.",
  "Feeling — it's a state, not a task":"Feelings ask to be regulated, not solved. Name it, let it be there, and choose your action anyway.",
  "Forecast — it hasn't happened yet":"Forecasts borrow trouble from a future that may not arrive. Park it — deal in what's in front of you."
};
function pickKind(btn){
  btn.parentElement.querySelectorAll('.chip').forEach(c=>c.classList.remove('selected'));
  btn.classList.add('selected');
  state.clarifyKind = btn.dataset.kind;
  document.getElementById('kindNote').textContent = kindNotes[state.clarifyKind]||'';
}
function refreshPicks(){
  state.dumps = [0,1,2].map(i=>document.getElementById('dump'+i).value.trim());
  const holder=document.getElementById('dumpPicks');
  const hint=document.getElementById('dumpHint');
  holder.innerHTML='';
  const filled = state.dumps.filter(Boolean);
  if(!filled.length){ hint.textContent='Your picks will appear here once you\'ve written a line or two.'; state.signal=null; return; }
  hint.textContent='Tap the one that\'s genuinely yours to move today:';
  state.dumps.forEach((d,i)=>{
    if(!d) return;
    const b=document.createElement('button');
    b.className='chip pick-chip'+(state.signal===d?' selected':'');
    b.textContent=d;
    b.onclick=()=>{ state.signal=d; refreshPicks();
      hint.textContent='"'+d+'" — that\'s your signal. The rest is noise for now.'; };
    holder.appendChild(b);
  });
}

/* ---- Choose ---- */
function buildCommit(){
  state.commitWhen=document.getElementById('commitWhen').value.trim();
  state.commitWhat=document.getElementById('commitWhat').value.trim();
  const p=document.getElementById('commitPreview');
  if(!state.commitWhen && !state.commitWhat){
    p.innerHTML='<span class="commit-empty">Your commitment will take shape here.</span>'; return;
  }
  p.innerHTML = '<em>'+(esc(state.commitWhen)||'When…')+'</em>, I will '+(esc(state.commitWhat)||'…');
}

/* ---- Repeat ---- */
function pickReturn(btn){
  btn.parentElement.querySelectorAll('.chip').forEach(c=>c.classList.remove('selected'));
  btn.classList.add('selected');
  state.returnWhen=btn.dataset.when;
  document.getElementById('returnNote').textContent='Noted. A loop you\'ve scheduled is a loop that happens.';
}

function esc(s){const d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
function line(label,val){
  return '<div class="summary-block"><h3>'+label+'</h3><p>'+(val?esc(val):'<span class="summary-empty">— not captured this time —</span>')+'</p></div>';
}
function renderSummary(){
  const c=document.getElementById('summaryCard');
  c.innerHTML =
    line('Centre · System state', state.band ? state.band + (state.breathDone?' · one regulated minute completed':'') : null) +
    line('Clarify · What had the most space', state.clarifyItem ? state.clarifyItem + (state.clarifyKind?'  ('+state.clarifyKind.split(' — ')[0]+')':'') : null) +
    line('Clarify · The one signal', state.signal) +
    line('Choose · Why it matters', state.chooseWhy) +
    line('Choose · Commitment', (state.commitWhen||state.commitWhat) ? (state.commitWhen||'When…')+', I will '+(state.commitWhat||'…') : null) +
    line('Repeat · What shifted', state.shift) +
    line('Repeat · Next loop', state.returnWhen);
}

function sessionText(){
  const d=new Date();
  const v=x=>x||'—';
  return [
'THE EXECUTIVE FRAME™ · C³ LOOP™ — REFLECTION',
d.toLocaleDateString()+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}),
'',
'01 CENTRE',
'  System state: '+v(state.band)+(state.breathDone?'  (one regulated minute completed)':''),
'',
'02 CLARIFY',
'  Most space in mind: '+v(state.clarifyItem)+(state.clarifyKind?'  ['+state.clarifyKind+']':''),
'  Three lines: '+(state.dumps.filter(Boolean).join(' | ')||'—'),
'  The one signal: '+v(state.signal),
'',
'03 CHOOSE',
'  Why it matters: '+v(state.chooseWhy),
'  Commitment: '+((state.commitWhen||state.commitWhat)?(state.commitWhen||'When…')+', I will '+(state.commitWhat||'…'):'—'),
'',
'04 REPEAT',
'  What shifted: '+v(state.shift),
'  Next loop: '+v(state.returnWhen),
'',
'A reflective practice, not an assessment.',
'© The Executive Frame™ · Sarah Anticich Consulting'
  ].join('\n');
}

function exportSession(){
  try{
    const blob=new Blob([sessionText()],{type:'text/plain'});
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='c3-loop-reflection.txt';
    document.body.appendChild(a); a.click(); a.remove();
    toast('Reflection downloaded');
  }catch(e){ copySession(); }
}
function copySession(){
  const t=sessionText();
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(t).then(()=>toast('Copied to clipboard'),()=>fallbackCopy(t));
  } else fallbackCopy(t);
}
function fallbackCopy(t){
  const ta=document.createElement('textarea');
  ta.value=t; document.body.appendChild(ta); ta.select();
  try{document.execCommand('copy');toast('Copied to clipboard');}catch(e){toast('Select & copy manually');}
  ta.remove();
}
let toastTimer=null;
function toast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg; el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('show'),2200);
}

function restart(){
  Object.assign(state,{band:null,clarifyItem:'',clarifyKind:null,dumps:['','',''],signal:null,chooseWhy:'',commitWhen:'',commitWhat:'',shift:'',returnWhen:null,breathDone:false});
  document.querySelectorAll('input,textarea').forEach(el=>el.value='');
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('selected'));
  ['bandNote','kindNote','returnNote'].forEach(id=>document.getElementById(id).textContent='');
  document.getElementById('dumpPicks').innerHTML='';
  document.getElementById('dumpHint').textContent='Your picks will appear here once you\'ve written a line or two.';
  buildCommit();
  go(1);
}
</script>
</body>
